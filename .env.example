# Booking enquiries
#
# Without these the site still works: enquiries are validated, the visitor sees
# the success screen, and the payload is written to the server log. Set them to
# have enquiries land in the agency's inbox.
#
# Resend (https://resend.com) — create an API key and verify ellotravel.net
# as a sending domain.
RESEND_API_KEY=

# Must be an address on a domain verified with Resend.
INQUIRY_FROM_EMAIL="Ello Travel <rezervime@ellotravel.net>"

# Where enquiries are delivered. Defaults to the address in src/data/site.ts.
INQUIRY_TO_EMAIL=ellotravel@hotmail.com

# Analytics
#
# GA4 measurement ID for ellotravel.net. Leave it unset to disable analytics
# entirely — useful for local work and preview deploys, which would otherwise
# skew the agency's reports.
#
# NEXT_PUBLIC_* values are inlined at build time, not read at runtime, so this
# must be set on the host *before* the production build runs.
NEXT_PUBLIC_GA_ID=G-CPLEQN6ZST
